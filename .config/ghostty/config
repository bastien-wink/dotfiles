# Configuration Ghostty pour remplacer tmux
# Fichier: ~/.config/ghostty/config
theme = Dimidium
#theme = GitHub Light High Contrast
font-size = 10
#copy-on-select = clipboard
#app-notifications = no-clipboard-copy

# Pour les chemins PHP avec numéros de ligne
custom-shader-animation = false

# Couleurs et apparence
background-opacity = 1
window-decoration = false

# Nouveaux onglets (équivalent tmux new-window)
keybind = ctrl+t=new_tab

# Navigation entre onglets (équivalent tmux window switching)
keybind = shift+left=previous_tab
keybind = shift+right=next_tab

# Fermeture d'onglet (équivalent tmux kill-pane/window)
keybind = alt+x=close_surface
keybind = ctrl+shift+w=close_surface

# Division d'écran
keybind = alt+&=new_split:right
keybind = alt+é=new_split:down

# Navigation entre panes
keybind = alt+left=goto_split:left
keybind = alt+right=goto_split:right
keybind = alt+up=goto_split:up
keybind = alt+down=goto_split:down

# Zoom/maximiser pane
keybind = alt+z=toggle_split_zoom
keybind = global:alt+a=toggle_visibility

# Shell par défaut (fish comme dans votre tmux)
command = /usr/bin/fish

confirm-close-surface = false
keybind = shift+enter=text:\x1b\r⏎

window-width = 9999
window-height = 9999

keybind = cmd+m=prompt_surface_title

